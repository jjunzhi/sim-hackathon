{
  "name": "weddingvista",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contrast": "node scripts/check-contrast.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "functions:install": "npm --prefix functions install",
    "functions:build": "npm --prefix functions run build",
    "emulators": "npm run functions:build && firebase emulators:start",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run --config vitest.emulator.config.mts tests/rules\"",
    "test:functions": "npm run functions:build && firebase emulators:exec --only auth,firestore,storage,functions \"vitest run --config vitest.emulator.config.mts tests/functions\"",
    "test:all": "npm test && npm run test:rules && npm run test:functions"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "heic-to": "1.6.6",
    "lucide-react": "1.61.0",
    "motion": "14.5.0",
    "next": "16.4.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "15.34.1",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
