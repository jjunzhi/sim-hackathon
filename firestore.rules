rules_version = '2';

// Every rule here has a test in tests/rules/firestore.rules.test.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isVendor() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'vendor';
    }

    function isCouple() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'couple';
    }

    // Family members viewing a share link sign in anonymously.
    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isInt(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    function isText(v, max) {
      return v is string && v.size() <= max;
    }

    // YYYY-MM-DD; the client checks the calendar, the rule checks the shape.
    function isIsoDate(v) {
      return v is string && v.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
    }

    // ---------- users/{uid}: role and PDPA consent, written once ----------
    // Role is chosen at sign-up and can never be changed by the client.
    // The profile is deleted only by the deleteAccount function (Admin SDK).
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      // Anonymous (family voting) sessions can never become a couple or vendor.
      allow create: if signedIn() && request.auth.uid == uid && !isAnonymous()
        && request.resource.data.keys().hasOnly(['role', 'consent', 'createdAt'])
        && request.resource.data.keys().hasAll(['role', 'consent', 'createdAt'])
        && request.resource.data.role in ['couple', 'vendor']
        && request.resource.data.consent.keys().hasOnly(['version', 'acceptedAt'])
        && request.resource.data.consent.keys().hasAll(['version', 'acceptedAt'])
        && request.resource.data.consent.version is string
        && request.resource.data.consent.version.size() > 0
        && request.resource.data.consent.version.size() <= 32
        && request.resource.data.consent.acceptedAt == request.time
        && request.resource.data.createdAt == request.time;

      // The reader's language is the one thing a user may change later (Phase 6).
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['locale'])
        && request.resource.data.locale in ['en', 'zh', 'ms', 'ta'];
      allow delete: if false;
    }

    // ---------- venues ----------
    function validTags(t) {
      return t is list && t.size() <= 12;
    }

    // Vendor-declared dietary coverage (Phase 6): ids only, each at most once.
    function validDietTags(t) {
      return t is list && t.size() <= 5 && t.toSet().size() == t.size()
        && t.hasOnly(['halal', 'vegetarian', 'vegan', 'no-beef', 'no-pork']);
    }

    function validTax(t) {
      return t is map
        && t.keys().hasOnly(['serviceChargeBps', 'gstBps', 'noServiceChargeNote', 'noGstNote'])
        && t.keys().hasAll(['serviceChargeBps', 'gstBps', 'noServiceChargeNote', 'noGstNote'])
        && t.serviceChargeBps in [0, 1000]
        && t.gstBps in [0, 900]
        && isText(t.noServiceChargeNote, 200)
        && isText(t.noGstNote, 200);
    }

    // folder: the Storage folder the photo must live in, e.g. "venues/abc".
    function validPhoto(p, folder) {
      return p == null || (
        p is map
        && p.keys().hasOnly(['path', 'width', 'height', 'contentType'])
        && p.keys().hasAll(['path', 'width', 'height', 'contentType'])
        && p.path is string
        && p.path.matches(folder + '/[A-Za-z0-9/_-]+[.](webp|jpg)')
        && isInt(p.width, 1, 4096)
        && isInt(p.height, 1, 4096)
        && p.contentType in ['image/webp', 'image/jpeg']
      );
    }

    function validVenue(d, venueId) {
      // Tax settings live on the vendor's business profile, not the venue.
      // capacitySummary is optional and written only by the server trigger.
      return d.keys().hasOnly([
          'ownerUid', 'status', 'verified', 'name', 'address', 'postalCode', 'description',
          'styleTags', 'cultureTags', 'wheelchairAccess', 'liftAccess',
          'stepFreeEntrance', 'accessibleToilet', 'accessibleParking', 'menuOptions', 'coverPhoto',
          'capacitySummary', 'listed', 'createdAt', 'updatedAt'])
        && d.keys().hasAll([
          'ownerUid', 'status', 'verified', 'name', 'address', 'postalCode', 'description',
          'styleTags', 'cultureTags', 'wheelchairAccess', 'liftAccess', 'coverPhoto',
          'createdAt', 'updatedAt'])
        && d.status in ['draft', 'active']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && isText(d.address, 300)
        && d.postalCode is string && d.postalCode.matches('([0-9]{6})?')
        && isText(d.description, 2000)
        && validTags(d.styleTags)
        && validTags(d.cultureTags)
        && d.wheelchairAccess is bool
        && d.liftAccess is bool
        // Phase 6 fields are optional so venues saved earlier can still be updated.
        && d.get('stepFreeEntrance', false) is bool
        && d.get('accessibleToilet', false) is bool
        && d.get('accessibleParking', false) is bool
        && validDietTags(d.get('menuOptions', []))
        && validPhoto(d.coverPhoto, 'venues/' + venueId)
        && d.updatedAt == request.time;
    }

    match /venues/{venueId} {
      // Anyone can open an active venue they already know (saved plans, family
      // links). Finding it in the catalog also needs `listed`: the vendor's plan
      // is in good standing (Phase 7). Owners always see their own.
      allow get: if resource.data.status == 'active'
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if (resource.data.status == 'active' && resource.data.listed == true)
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      // Only vendors create venues, always as an unverified draft they own.
      allow create: if isVendor()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.verified == false
        && !('capacitySummary' in request.resource.data)
        && !('listed' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && validVenue(request.resource.data, venueId);

      // "verified" is admin-only: the client can never change it.
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.get('capacitySummary', null) == resource.data.get('capacitySummary', null)
        && request.resource.data.get('listed', null) == resource.data.get('listed', null)
        && request.resource.data.createdAt == resource.data.createdAt
        && validVenue(request.resource.data, venueId);

      // Venues are removed only by account deletion (Admin SDK).
      allow delete: if false;

      // ---------- spaces ----------
      function venue() {
        return get(/databases/$(database)/documents/venues/$(venueId)).data;
      }

      function ownsVenue() {
        return signedIn() && venue().ownerUid == request.auth.uid;
      }

      function validTier(t) {
        return t is map
          && t.keys().hasOnly(['roomRentalCents', 'minimumSpendCents'])
          && t.keys().hasAll(['roomRentalCents', 'minimumSpendCents'])
          && isInt(t.roomRentalCents, 0, 100000000000)
          && (t.minimumSpendCents == null || isInt(t.minimumSpendCents, 0, 100000000000));
      }

      // Either one standard price, or both Peak and Off-Peak.
      function validTiers(t) {
        return t is map && (
          (t.keys().hasOnly(['standard']) && t.keys().hasAll(['standard']) && validTier(t.standard))
          || (t.keys().hasOnly(['peak', 'offPeak']) && t.keys().hasAll(['peak', 'offPeak'])
              && validTier(t.peak) && validTier(t.offPeak))
        );
      }

      function validSpace(d) {
        return d.keys().hasOnly([
            'name', 'capacityMin', 'capacityMax', 'seatsPerTable', 'tiers', 'photo',
            'photoVersion', 'sortOrder', 'createdAt', 'updatedAt'])
          && d.keys().hasAll([
            'name', 'capacityMin', 'capacityMax', 'seatsPerTable', 'tiers', 'photo',
            'photoVersion', 'sortOrder', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && isInt(d.capacityMin, 1, 5000)
          && isInt(d.capacityMax, 1, 5000)
          && d.capacityMin <= d.capacityMax
          && isInt(d.seatsPerTable, 1, 30)
          && validTiers(d.tiers)
          && validPhoto(d.photo, 'venues/' + venueId)
          && isInt(d.sortOrder, 0, 1000)
          && d.updatedAt == request.time;
      }

      match /spaces/{spaceId} {
        allow read: if venue().status == 'active' || ownsVenue();

        allow create: if ownsVenue()
          && validSpace(request.resource.data)
          && request.resource.data.photoVersion == 0
          && request.resource.data.createdAt == request.time;

        // photoVersion only ever goes up by one (it feeds the render cache key).
        allow update: if ownsVenue()
          && validSpace(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && (request.resource.data.photoVersion == resource.data.photoVersion
              || request.resource.data.photoVersion == resource.data.photoVersion + 1);

        allow delete: if ownsVenue();
      }
    }

    // ---------- vendors/{uid}: business profile, inventory, packages ----------
    function validVendor(d) {
      return d.keys().hasOnly([
          'kinds', 'businessName', 'description', 'tax', 'servesAnyVenue', 'servesVenueIds',
          'published', 'listed', 'createdAt', 'updatedAt'])
        && d.keys().hasAll([
          'kinds', 'businessName', 'description', 'tax', 'servesAnyVenue', 'servesVenueIds',
          'published', 'createdAt', 'updatedAt'])
        && d.kinds is list && d.kinds.size() >= 1 && d.kinds.size() <= 2
        && d.kinds.hasOnly(['venue', 'decorator'])
        && d.businessName is string && d.businessName.size() > 0 && d.businessName.size() <= 120
        && isText(d.description, 2000)
        && validTax(d.tax)
        && d.servesAnyVenue is bool
        && d.servesVenueIds is list && d.servesVenueIds.size() <= 50
        && d.published is bool
        && d.updatedAt == request.time;
    }

    function validPrice(p) {
      return isInt(p, 0, 100000000000);
    }

    match /vendors/{uid} {
      function ownsVendor() {
        return signedIn() && request.auth.uid == uid;
      }

      function vendorPublished() {
        return get(/databases/$(database)/documents/vendors/$(uid)).data.published == true;
      }

      function vendorExists() {
        return exists(/databases/$(database)/documents/vendors/$(uid));
      }

      // Direct reads keep existing plans priced; discovery (decorators for a
      // venue) also needs `listed`, which only the server writes (Phase 7).
      allow get: if resource.data.published == true || ownsVendor();
      allow list: if (resource.data.published == true && resource.data.listed == true) || ownsVendor();
      allow create: if ownsVendor() && isVendor()
        && validVendor(request.resource.data)
        && !('listed' in request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if ownsVendor()
        && validVendor(request.resource.data)
        && request.resource.data.get('listed', null) == resource.data.get('listed', null)
        && request.resource.data.createdAt == resource.data.createdAt;
      // Removed only by account deletion (Admin SDK).
      allow delete: if false;

      function validItem(d) {
        return d.keys().hasOnly(['name', 'category', 'unit', 'priceCents', 'description', 'photo', 'active', 'dietaryTags', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['name', 'category', 'unit', 'priceCents', 'description', 'photo', 'active', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && d.category in ['Florals', 'Lighting', 'Backdrops and stage', 'Table decor', 'Furniture', 'Draping', 'Signage', 'Food and drink', 'Other']
          && d.unit in ['piece', 'table', 'guest']
          && validPrice(d.priceCents)
          && isText(d.description, 1000)
          && validPhoto(d.photo, 'vendors/' + uid)
          && d.active is bool
          && validDietTags(d.get('dietaryTags', []))
          && d.updatedAt == request.time;
      }

      function validPackage(d) {
        return d.keys().hasOnly(['name', 'unit', 'priceCents', 'description', 'itemIds', 'photo', 'active', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['name', 'unit', 'priceCents', 'description', 'itemIds', 'photo', 'active', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && d.unit in ['piece', 'table', 'guest']
          && validPrice(d.priceCents)
          && isText(d.description, 1000)
          && d.itemIds is list && d.itemIds.size() >= 1 && d.itemIds.size() <= 30
          && validPhoto(d.photo, 'vendors/' + uid)
          && d.active is bool
          && d.updatedAt == request.time;
      }

      // Couples see active items only once the business is published.
      match /items/{itemId} {
        allow read: if ownsVendor() || (resource.data.active == true && vendorPublished());
        allow create: if ownsVendor() && vendorExists()
          && validItem(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if ownsVendor()
          && validItem(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if ownsVendor();
      }

      match /packages/{packageId} {
        allow read: if ownsVendor() || (resource.data.active == true && vendorPublished());
        allow create: if ownsVendor() && vendorExists()
          && validPackage(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if ownsVendor()
          && validPackage(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if ownsVendor();
      }

      // Dates the vendor already has booked (Phase 6). Public once published, like items.
      match /blockedDates/{dateId} {
        allow read: if ownsVendor() || vendorPublished();
        allow create: if ownsVendor() && vendorExists()
          && request.resource.data.keys().hasOnly(['date', 'note', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['date', 'note', 'createdAt', 'updatedAt'])
          && isIsoDate(request.resource.data.date)
          && isText(request.resource.data.note, 80)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if false;
        allow delete: if ownsVendor();
      }
    }

    // ---------- projects/{id}: a couple's saved plans (owner only) ----------
    function validPlan(d) {
      return d.keys().hasOnly([
          'ownerUid', 'name', 'venueId', 'spaceId', 'tierKey', 'headcount', 'themeId',
          'selections', 'savedRenders', 'weddingDate', 'budgetCents', 'brief', 'timeline',
          'createdAt', 'updatedAt'])
        && d.keys().hasAll([
          'ownerUid', 'name', 'venueId', 'spaceId', 'tierKey', 'headcount', 'themeId',
          'selections', 'savedRenders', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.venueId is string && d.venueId.size() > 0 && d.venueId.size() <= 128
        && (d.spaceId == null || (d.spaceId is string && d.spaceId.size() <= 128))
        && d.tierKey in ['standard', 'peak', 'offPeak', null]
        && isInt(d.headcount, 0, 7000)
        && isText(d.themeId, 64)
        && d.selections is map && d.selections.size() <= 60
        && d.savedRenders is list && d.savedRenders.size() <= 6
        && (d.get('weddingDate', null) == null || isIsoDate(d.weddingDate))
        && (d.get('budgetCents', null) == null || isInt(d.budgetCents, 1, 1000000000))
        && (d.get('brief', null) == null || validBrief(d.brief))
        && validTimeline(d.get('timeline', []))
        && d.updatedAt == request.time;
    }

    // Aria's planning brief: the couple's own words (short) and fixed tags.
    function validBrief(b) {
      return b is map
        && b.keys().hasOnly(['style', 'traditions', 'dietaryTags', 'stepFree', 'notes'])
        && b.keys().hasAll(['style', 'traditions', 'dietaryTags', 'stepFree', 'notes'])
        && isText(b.style, 200)
        && isText(b.notes, 500)
        && b.traditions is list && b.traditions.size() <= 7 && b.traditions.toSet().size() == b.traditions.size()
        && b.traditions.hasOnly(['Chinese', 'Malay', 'Indian', 'Peranakan', 'Western', 'Fusion', 'Halal-friendly'])
        && validDietTags(b.dietaryTags)
        && b.stepFree is bool;
    }

    // Kept lean: rules stop at 1000 evaluated expressions per write. A missing
    // or non-text field makes matches() error, which denies the write.
    function validTimelineEntry(e) {
      return e.keys().hasOnly(['time', 'label'])
        && e.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && e.label.matches('[^\n]{1,120}');
    }

    // Rules have no loops, so each of the (at most 15) entries is checked by index.
    // 15, not more: a full plan must stay under the 1000-expression limit.
    function validTimeline(t) {
      return t is list && t.size() <= 15
        && (t.size() <= 0 || validTimelineEntry(t[0]))
        && (t.size() <= 1 || validTimelineEntry(t[1]))
        && (t.size() <= 2 || validTimelineEntry(t[2]))
        && (t.size() <= 3 || validTimelineEntry(t[3]))
        && (t.size() <= 4 || validTimelineEntry(t[4]))
        && (t.size() <= 5 || validTimelineEntry(t[5]))
        && (t.size() <= 6 || validTimelineEntry(t[6]))
        && (t.size() <= 7 || validTimelineEntry(t[7]))
        && (t.size() <= 8 || validTimelineEntry(t[8]))
        && (t.size() <= 9 || validTimelineEntry(t[9]))
        && (t.size() <= 10 || validTimelineEntry(t[10]))
        && (t.size() <= 11 || validTimelineEntry(t[11]))
        && (t.size() <= 12 || validTimelineEntry(t[12]))
        && (t.size() <= 13 || validTimelineEntry(t[13]))
        && (t.size() <= 14 || validTimelineEntry(t[14]));
    }

    match /projects/{projectId} {
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isCouple()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validPlan(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && validPlan(request.resource.data);

      // Aria's decision log: what the couple applied, adjusted or declined.
      // Owner-only, write-once, and deleted with the plan (planDecisionsCleanup).
      match /decisions/{decisionId} {
        function ownsPlan() {
          return signedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid;
        }

        allow read, delete: if ownsPlan();
        allow create: if ownsPlan() && isCouple()
          && request.resource.data.keys().hasOnly(['action', 'summary', 'changes', 'beforeCents', 'afterCents', 'createdAt'])
          && request.resource.data.keys().hasAll(['action', 'summary', 'changes', 'beforeCents', 'afterCents', 'createdAt'])
          && request.resource.data.action in ['applied', 'adjusted', 'declined', 'alternatives']
          && isText(request.resource.data.summary, 400)
          && validDecisionChanges(request.resource.data.changes)
          && (request.resource.data.beforeCents == null || isInt(request.resource.data.beforeCents, 0, 100000000000))
          && (request.resource.data.afterCents == null || isInt(request.resource.data.afterCents, 0, 100000000000))
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }
    }

    function validDecisionLine(v) {
      return v is string && v.size() > 0 && v.size() <= 200;
    }

    // Up to 10 plain-text lines describing the changes, each checked by index.
    function validDecisionChanges(c) {
      return c is list && c.size() <= 10
        && (c.size() <= 0 || validDecisionLine(c[0]))
        && (c.size() <= 1 || validDecisionLine(c[1]))
        && (c.size() <= 2 || validDecisionLine(c[2]))
        && (c.size() <= 3 || validDecisionLine(c[3]))
        && (c.size() <= 4 || validDecisionLine(c[4]))
        && (c.size() <= 5 || validDecisionLine(c[5]))
        && (c.size() <= 6 || validDecisionLine(c[6]))
        && (c.size() <= 7 || validDecisionLine(c[7]))
        && (c.size() <= 8 || validDecisionLine(c[8]))
        && (c.size() <= 9 || validDecisionLine(c[9]));
    }

    // ---------- guestLists/{uid}: the couple's own guest helper ----------
    // Minimum data: a label the couple writes, a tier and seat counts. No contact details.
    match /guestLists/{uid} {
      function ownsList() {
        return signedIn() && request.auth.uid == uid;
      }

      allow read, delete: if ownsList();
      allow create, update: if ownsList() && isCouple()
        && request.resource.data.keys().hasOnly(['trimOrder', 'planId', 'updatedAt'])
        && request.resource.data.trimOrder is list
        && request.resource.data.trimOrder.size() == 3
        && request.resource.data.trimOrder.hasAll(['casual', 'close', 'extended'])
        && (request.resource.data.planId == null || isText(request.resource.data.planId, 128))
        && request.resource.data.updatedAt == request.time;

      match /parties/{partyId} {
        allow read, delete: if ownsList();
        allow create, update: if ownsList() && isCouple()
          && request.resource.data.keys().hasOnly(['label', 'tier', 'seats', 'plusOnes', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['label', 'tier', 'seats', 'plusOnes', 'createdAt', 'updatedAt'])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 80
          && request.resource.data.tier in ['must', 'extended', 'close', 'casual']
          && isInt(request.resource.data.seats, 1, 30)
          && isInt(request.resource.data.plusOnes, 0, 10)
          && request.resource.data.updatedAt == request.time;
      }
    }

    // ---------- shares/{shareId}: family links ----------
    // The id is 128 random bits: knowing it is the permission to view.
    // Links can be fetched by id, never listed by others. Revoking clears the
    // options, so a revoked link shows nothing but its status.
    function validShareOption(o) {
      return o is map
        && o.keys().hasOnly(['planId', 'venueName', 'planName', 'renderKey', 'renderPath', 'themeId', 'demo', 'aspect', 'estimateTotalCents'])
        && o.renderPath is string && o.renderPath.matches('renders/[0-9a-f]{64}[.]jpg')
        && isInt(o.estimateTotalCents, 0, 100000000000);
    }

    match /shares/{shareId} {
      function share() {
        return get(/databases/$(database)/documents/shares/$(shareId)).data;
      }

      allow get: if signedIn();
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isCouple()
        && shareId.size() >= 22
        && request.resource.data.keys().hasOnly(['ownerUid', 'title', 'status', 'options', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && isText(request.resource.data.title, 80)
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 3
        && validShareOption(request.resource.data.options[0])
        && validShareOption(request.resource.data.options[1])
        && (request.resource.data.options.size() < 3 || validShareOption(request.resource.data.options[2]))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // The only change allowed is revoking, which is final.
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'options', 'title', 'updatedAt'])
        && request.resource.data.status == 'revoked'
        && request.resource.data.options.size() == 0
        && request.resource.data.title == ''
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // One vote per voter per link: the document id is the voter's uid and
      // votes can never be changed or deleted by a client. No IP addresses.
      match /votes/{voterId} {
        allow read: if signedIn() && (request.auth.uid == voterId || share().ownerUid == request.auth.uid);
        allow create: if signedIn() && request.auth.uid == voterId
          && share().status == 'active'
          && request.resource.data.keys().hasOnly(['optionIndex', 'name', 'note', 'createdAt'])
          && request.resource.data.keys().hasAll(['optionIndex', 'name', 'note', 'createdAt'])
          && isInt(request.resource.data.optionIndex, 0, share().options.size() - 1)
          && isText(request.resource.data.name, 40)
          && isText(request.resource.data.note, 280)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        // Only the couple, when deleting their own link.
        allow delete: if signedIn() && share().ownerUid == request.auth.uid;
      }
    }

    // ---------- leads/{leadId}: a couple asks one vendor to confirm ----------
    match /leads/{leadId} {
      allow read: if signedIn() && (resource.data.coupleUid == request.auth.uid || resource.data.vendorUid == request.auth.uid);
      allow create: if isCouple()
        && request.resource.data.keys().hasOnly([
            'coupleUid', 'vendorUid', 'venueOwnerUid', 'planId', 'venueId', 'venueName', 'vendorName',
            'spaceId', 'spaceName', 'tierKey', 'headcount', 'selections', 'renders', 'contact',
            'status', 'confirmationId', 'createdAt', 'updatedAt'])
        && request.resource.data.coupleUid == request.auth.uid
        && request.resource.data.vendorUid is string && request.resource.data.vendorUid != request.auth.uid
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.planId))
        && get(/databases/$(database)/documents/projects/$(request.resource.data.planId)).data.ownerUid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.confirmationId == null
        && isInt(request.resource.data.headcount, 0, 7000)
        && request.resource.data.selections is map && request.resource.data.selections.size() <= 60
        && request.resource.data.renders is list && request.resource.data.renders.size() <= 6
        && request.resource.data.contact is map
        && request.resource.data.contact.keys().hasOnly(['name', 'reachAt', 'eventDate', 'message'])
        && request.resource.data.contact.name is string && request.resource.data.contact.name.size() > 0
        && isText(request.resource.data.contact.name, 80)
        && request.resource.data.contact.reachAt is string && request.resource.data.contact.reachAt.size() > 0
        && isText(request.resource.data.contact.reachAt, 120)
        && isText(request.resource.data.contact.eventDate, 20)
        && isText(request.resource.data.contact.message, 1000)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // The vendor may only decline, or mark confirmed alongside its confirmation.
      allow update: if signedIn()
        && resource.data.vendorUid == request.auth.uid
        && resource.data.status == 'new'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmationId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.status == 'declined' && request.resource.data.confirmationId == null)
          || (request.resource.data.status == 'confirmed'
              && request.resource.data.confirmationId == leadId
              && existsAfter(/databases/$(database)/documents/confirmations/$(leadId)))
        );
      // A couple can withdraw a request that hasn't been confirmed.
      allow delete: if signedIn() && resource.data.coupleUid == request.auth.uid && resource.data.status != 'confirmed';
    }

    // ---------- confirmations/{leadId}: immutable vendor-confirmed snapshot ----------
    match /confirmations/{leadId} {
      function lead() {
        return get(/databases/$(database)/documents/leads/$(leadId)).data;
      }

      allow read: if signedIn() && (resource.data.vendorUid == request.auth.uid || resource.data.coupleUid == request.auth.uid);
      allow create: if signedIn()
        && lead().vendorUid == request.auth.uid
        && lead().status == 'new'
        && request.resource.data.keys().hasOnly([
            'leadId', 'vendorUid', 'coupleUid', 'planId', 'vendorName', 'venueName', 'spaceName', 'tierKey',
            'headcount', 'snapshot', 'engineVersion', 'confirmedBy', 'confirmedByName', 'note', 'confirmedAt', 'validUntil'])
        && request.resource.data.leadId == leadId
        && request.resource.data.vendorUid == request.auth.uid
        && request.resource.data.confirmedBy == request.auth.uid
        && request.resource.data.coupleUid == lead().coupleUid
        && request.resource.data.planId == lead().planId
        && request.resource.data.headcount == lead().headcount
        && request.resource.data.snapshot is map
        && isText(request.resource.data.note, 500)
        && request.resource.data.confirmedAt == request.time
        && request.resource.data.validUntil is timestamp
        && request.resource.data.validUntil > request.time
        && request.resource.data.validUntil <= request.time + duration.value(91, 'd')
        && getAfter(/databases/$(database)/documents/leads/$(leadId)).data.status == 'confirmed';
      // Confirmed estimates never change. Only account deletion (Admin SDK) touches them.
      allow update, delete: if false;
    }

    // ---------- renders (written only by the requestRender function) ----------
    // No personal data; shared between couples. Family members viewing a share
    // link sign in anonymously, which counts as signed in.
    match /renders/{key} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Render usage counters: each person sees only their own (vendors see their venue's).
    match /usage/{id} {
      allow read: if signedIn() && resource.data.subject == request.auth.uid;
      allow write: if false;
    }

    // Public catalog flags (e.g. "these are SAMPLE listings"); written by admin scripts only.
    match /config/catalog {
      allow read: if true;
      allow write: if false;
    }

    // Render limits are not secret; only an admin changes them (console / Admin SDK).
    match /config/renderLimits {
      allow read: if signedIn();
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
    // ---------- checklists/{uid}: ritual checklist ticks and the couple's own items (Phase 6) ----------
    match /checklists/{uid} {
      function ownsChecklist() {
        return signedIn() && request.auth.uid == uid;
      }

      allow read, delete: if ownsChecklist();
      allow create, update: if ownsChecklist() && isCouple()
        && request.resource.data.keys().hasOnly(['ticks', 'updatedAt'])
        && request.resource.data.ticks is map
        && request.resource.data.ticks.size() <= 400
        && request.resource.data.updatedAt == request.time;

      match /items/{itemId} {
        allow read, delete: if ownsChecklist();
        allow create, update: if ownsChecklist() && isCouple()
          && request.resource.data.keys().hasOnly(['ritualId', 'text', 'done', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['ritualId', 'text', 'done', 'createdAt', 'updatedAt'])
          && request.resource.data.ritualId in ['tea', 'nikah', 'vivaha', 'rom']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 120
          && request.resource.data.done is bool
          && request.resource.data.updatedAt == request.time;
      }
    }

    // ---------- billing/{uid}: plan status (Phase 7) ----------
    // Written only by the server: the Stripe webhook, invite redemption and admin scripts.
    match /billing/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- bookings/{leadId}: a confirmed lead that became a booking (Phase 7) ----------
    // The vendor says it booked; the couple confirms or disputes. Only confirmed
    // bookings count towards commission. No contact details are copied here.
    match /bookings/{leadId} {
      function lead() {
        return get(/databases/$(database)/documents/leads/$(leadId)).data;
      }

      function validBookingFields(d) {
        return isIsoDate(d.eventDate)
          && (d.valueCents == null || isInt(d.valueCents, 0, 100000000000));
      }

      allow read: if signedIn()
        && (resource.data.vendorUid == request.auth.uid || resource.data.coupleUid == request.auth.uid);

      allow create: if signedIn()
        && exists(/databases/$(database)/documents/leads/$(leadId))
        && lead().vendorUid == request.auth.uid
        && lead().status == 'confirmed'
        && request.resource.data.keys().hasOnly(['leadId', 'vendorUid', 'coupleUid', 'eventDate', 'valueCents', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['leadId', 'vendorUid', 'coupleUid', 'eventDate', 'valueCents', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.leadId == leadId
        && request.resource.data.vendorUid == request.auth.uid
        && request.resource.data.coupleUid == lead().coupleUid
        && request.resource.data.status == 'claimed'
        && validBookingFields(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // The couple answers a claim once: confirmed or disputed.
      allow update: if signedIn()
        && resource.data.coupleUid == request.auth.uid
        && resource.data.status == 'claimed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'updatedAt'])
        && request.resource.data.status in ['confirmed', 'disputed']
        && request.resource.data.respondedAt == request.time
        && request.resource.data.updatedAt == request.time;

      // The vendor may correct the date or value, which asks the couple again.
      allow update: if signedIn()
        && resource.data.vendorUid == request.auth.uid
        && resource.data.status in ['claimed', 'disputed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventDate', 'valueCents', 'status', 'updatedAt'])
        && request.resource.data.status == 'claimed'
        && validBookingFields(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      // A claim can be withdrawn until the couple confirms it.
      allow delete: if signedIn()
        && resource.data.vendorUid == request.auth.uid
        && resource.data.status != 'confirmed';
    }

    // ---------- feedback/{id}: vendors' in-app feedback during the pilot (Phase 7) ----------
    // Write-only from the app; read in the console.
    match /feedback/{id} {
      allow create: if isVendor()
        && request.resource.data.keys().hasOnly(['uid', 'text', 'page', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'text', 'page', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && isText(request.resource.data.page, 200)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

  }
}
