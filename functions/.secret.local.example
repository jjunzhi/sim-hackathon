# Copy to functions/.secret.local (git-ignored) for the Functions emulator.
# These are emulator-only values, never real keys.
GEMINI_API_KEY=demo
# "demo" turns Stripe calls off: Checkout and the Customer Portal report that billing isn't set up.
STRIPE_SECRET_KEY=demo
# Any value works locally; tests/functions/billing.test.ts signs its sample events with this one.
STRIPE_WEBHOOK_SECRET=whsec_emulator_only_not_a_real_secret
