# Copy to functions/.env for deploys (or answer the deploy prompts). Not secret.
# Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, GEMINI_API_KEY) go in Secret Manager:
#   npx firebase functions:secrets:set STRIPE_SECRET_KEY
# The monthly plan's Price ID from the Stripe dashboard (price_...).
STRIPE_PRICE_ID=
# Where Stripe sends vendors back after Checkout or the Customer Portal.
APP_BASE_URL=https://your-domain.example
