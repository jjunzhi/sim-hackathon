# Copy to .env.local and fill in. Never commit real values.

# --- Local development with the Firebase emulators (no Google account needed) ---
# The project ID must start with "demo-" so the app can never reach a real project.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-weddingvista.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-weddingvista
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-weddingvista.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-southeast1

# --- Real Firebase project (set USE_EMULATORS=false and replace the values above) ---
# From Firebase console > Project settings > Your apps > Web app config.
# reCAPTCHA Enterprise score-based site key for App Check (required when not using emulators).
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Gemini (Phase 3) - server only, never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=
