# Copy to .env.local and fill in. Never commit real values.
# Phase 0 needs no variables. Firebase, Gemini and Maps keys arrive in later phases.

# Firebase web config (Phase 1) - public identifiers, still kept out of git
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Gemini (Phase 3) - server only, never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=
